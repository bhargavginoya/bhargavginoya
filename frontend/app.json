{
  "expo": {
    "name": "HRMS",
    "slug": "hrms-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hrms",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take selfies for attendance verification",
        "NSLocationWhenInUseUsageDescription": "Track location for attendance check-in",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track location during work hours"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HRMS to track your location during work hours for attendance tracking."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HRMS to access camera for attendance selfie verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
